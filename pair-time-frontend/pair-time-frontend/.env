# 환경 설정 (development | production)
REACT_APP_ENV=development

# OAuth2 로그인 URL
# development: 빈 문자열 (프록시 사용으로 Same-Origin)
# production: https://yourdomain.com
REACT_APP_OAUTH2_URL=

# API Base URL
# development: 빈 문자열 (프록시 사용으로 Same-Origin)
# production: https://yourdomain.com
REACT_APP_API_URL=

# WithCredentials 설정 (쿠키 기반 인증 사용 시 true)
REACT_APP_WITH_CREDENTIALS=true
