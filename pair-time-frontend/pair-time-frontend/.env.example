# 환경 설정
# development: 로컬 개발 환경 (프록시 사용)
# production: 운영 환경 (직접 연결)
REACT_APP_ENV=development

# OAuth2 로그인 URL
# development: 빈 문자열 (setupProxy.js 프록시 사용)
# production: https://yourdomain.com
REACT_APP_OAUTH2_URL=

# API Base URL
# development: 빈 문자열 (setupProxy.js 프록시 사용)
# production: https://yourdomain.com
REACT_APP_API_URL=

# WithCredentials 설정 (쿠키 기반 인증 사용)
# true: 쿠키를 통해 인증 정보 전송
# false: 쿠키 없이 localStorage의 토큰만 사용
REACT_APP_WITH_CREDENTIALS=true
